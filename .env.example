# Database
DB_URL=jdbc:postgresql://localhost:5432/trackflow_db
DB_USERNAME=trackflow
DB_PASSWORD=trackflow_secret

# JWT
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
